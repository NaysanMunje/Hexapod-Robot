    <origin xyz="0.07736 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.136" effort="10" velocity="3"/>
  </joint>
  <link name="LF_shin1">
    <visual>
      <origin xyz="0.011179 0 0" rpy="0 1.5708 0"/>
