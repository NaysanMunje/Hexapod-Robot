<?xml version="1.0"?>
<!-- Full hexapod stick model: body + 6 legs at vertices. meters, +X fwd +Y left +Z up -->
<robot name="hexapod">
  <link name="base_link">
    <visual>
      <geometry><box size="0.146564 0.186859 0.008"/></geometry>
      <material name="plate"><color rgba="0.35 0.55 0.85 0.4"/></material>
    </visual>
  </link>

  <!-- ========== LEG LF ========== -->
  <joint name="LF_attach" type="fixed">
    <parent link="base_link"/>
    <child link="LF_hip"/>
    <origin xyz="0.073282 0.061608 0" rpy="0 0 1.161125"/>
  </joint>
  <link name="LF_hip"/>

  <joint name="LF_coxa_joint" type="revolute">
    <parent link="LF_hip"/>
    <child link="LF_coxa"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="10" velocity="3"/>
  </joint>
  <link name="LF_coxa">
    <visual>
      <origin xyz="0.0265 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder length="0.053" radius="0.0035"/></geometry>
      <material name="LF_c"><color rgba="0.8 0.25 0.25 1"/></material>
    </visual>
  </link>

  <joint name="LF_femur_joint" type="revolute">
    <parent link="LF_coxa"/>
    <child link="LF_femur"/>
    <origin xyz="0.053 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.789" upper="0" effort="10" velocity="3"/>
  </joint>
  <link name="LF_femur">
    <visual>
      <origin xyz="0.03868 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder length="0.07736" radius="0.0035"/></geometry>
      <material name="LF_f"><color rgba="0.2 0.55 0.9 1"/></material>
    </visual>
  </link>

  <joint name="LF_knee_joint" type="revolute">
    <parent link="LF_femur"/>
